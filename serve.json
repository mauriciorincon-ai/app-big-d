{
  "cleanUrls": [
    "/!(diseno)",
    "/!(diseno)/**"
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/es",
      "type": 307
    },
    {
      "source": "/diseno",
      "destination": "/diseno/index.html",
      "type": 307
    },
    {
      "source": "/diseno/",
      "destination": "/diseno/index.html",
      "type": 307
    }
  ],
  "headers": [
    {
      "source": "**",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ]
}
