{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "github": {
    "silent": true
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/es",
      "permanent": false
    },
    {
      "source": "/diseno",
      "destination": "/diseno/index.html",
      "permanent": false
    },
    {
      "source": "/diseno/",
      "destination": "/diseno/index.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/diseno/:pagina.html",
      "destination": "/diseno/:pagina"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ]
}
