# Variables de entorno de la app — copia a .env.local (gitignored) y llena lo que uses.
# Los valores reales JAMÁS se commitean; en Vercel van como env vars del proyecto.

# Sentry (opcional — sin DSN el cliente queda inerte, cero ruido en CI/local):
# NEXT_PUBLIC_SENTRY_DSN=

# Nombre de la app para logs/telemetría (opcional):
# NEXT_PUBLIC_APP_NAME=

# Big-D no tiene proveedor de modelos ni claves de API: el investigador es una skill de Claude Code que la
# persona corre en su sesión, con su suscripción (CLAUDE.md § Stack; decisions/investigator-7s-compliance.md).
# Ninguna clave de modelo entra a este archivo ni a Vercel.

# Perillas de build y de pruebas: se pasan en la línea de comando, NUNCA aquí ni en Vercel.
#   BIGD_FECHA_CONSULTA=AAAA-MM-DD  fija la fecha de consulta del build (capturas, envejecimiento); en un deploy
#                                   congelaría la vigencia del atlas
#   E2E_PUERTO=3147                 puerto de Playwright cuando el 3000 está ocupado
