{
  "name": "app-big-d",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3400",
    "build": "node scripts/instrumento/validar.mjs && node scripts/copiar-maqueta.mjs && next build && node scripts/csp/inyectar.mjs",
    "start": "serve out -l tcp://127.0.0.1:${PORT:-3400} --config ../serve.json",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "prepare": "git config core.hooksPath githooks",
    "capturas:maqueta": "node scripts/capturar-maqueta.mjs",
    "capturas:producto": "node scripts/capturar-producto.mjs",
    "datos:contrato": "node scripts/datos/desde-contrato.mjs",
    "maqueta": "node scripts/maqueta/generar.mjs",
    "brochure": "node scripts/brochure/generar.mjs",
    "build:demo": "node scripts/demo/construir.mjs && node scripts/demo/fugas.mjs",
    "demo:huellas": "node scripts/demo/huellas.mjs",
    "paleta:buscar": "node scripts/paleta/buscar.mjs",
    "tokens": "node scripts/paleta/generar-tokens.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.12.0",
    "diagramador": "workspace:*",
    "instrumentos-de-plan": "workspace:*",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fast-check": "4.10.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.10.0",
    "serve": "14.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.10.0"
}
